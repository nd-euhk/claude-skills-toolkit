{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "start-telemetry",
            "description": "Start OTLP telemetry collector for span/metric/event capture",
            "command": "./.claude/hooks/start-telemetry.sh",
            "timeout": 5000,
            "onError": "warn",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "stop-telemetry",
            "description": "Stop OTLP telemetry collector and cleanup PID file",
            "command": "./.claude/hooks/stop-telemetry.sh",
            "timeout": 5000,
            "onError": "warn",
            "async": true
          }
        ]
      }
    ]
  }
}
